def get_points(x_vals, y_vals):
    x_c = double2(*x_vals)
    y_c = double2(*y_vals)
    out = points_type()
    find_points(x_c, y_c, out)
    result = np.array([[out[i][0], out[i][1]] for i in range(2)])
    return result

if __name__ == '__main__':
    x_vals = [1.0, 4.0]
    y_vals = [1.0, 4.0]
    pts = get_points(x_vals, y_vals)
    print(pts)
