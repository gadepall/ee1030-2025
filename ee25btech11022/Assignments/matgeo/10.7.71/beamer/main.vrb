\frametitle{Python-Code}
\begin{lstlisting}
# Points
plt.scatter([O[0], A[0], P[0]], [O[1], A[1], P[1]], color='purple', zorder=5)
plt.text(O[0], O[1]-0.2, "O", fontsize=12)
plt.text(A[0]+0.1, A[1]-0.1, "A", fontsize=12)
plt.text(P[0]+0.1, P[1]+0.1, "P", fontsize=12)

plt.xlim(-1, 5)
plt.ylim(-1, 5)
plt.gca().set_aspect('equal')
plt.grid(True)
plt.legend()
plt.title("Triangle formed by X axis, tangent, normal to $x^2 + y^2 = 4$\nat $P(1,\\sqrt{3})$")
plt.show()
\end{lstlisting}
