\frametitle{Python Code}
    \begin{lstlisting}
# Labels and title
plt.xlabel("x-axis")
plt.ylabel("y-axis")
plt.title("Graph of Linear Equations")
plt.axhline(0, color='black', linewidth=0.5)
plt.axvline(0, color='black', linewidth=0.5)
plt.grid(True, linestyle="--", alpha=0.6)

# Show legend
plt.legend()

# Save the figure
plt.savefig("lines.png", dpi=300)

# Show the plot
plt.show()

    \end{lstlisting}
