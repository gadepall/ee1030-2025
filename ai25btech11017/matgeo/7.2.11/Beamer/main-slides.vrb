    \begin{lstlisting}
# Axes formatting
ax = plt.gca()
ax.spines['top'].set_color('none')
ax.spines['right'].set_color('none')
ax.spines['left'].set_position('zero')
ax.spines['bottom'].set_position('zero')
plt.legend()
plt.grid()
plt.axis("equal")

# Save and show
plt.savefig("circle_question.png", dpi=300)
plt.show()
     \end{lstlisting}
