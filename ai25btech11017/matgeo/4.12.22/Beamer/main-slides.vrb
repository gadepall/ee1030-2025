\frametitle{Python Code}
    \begin{lstlisting}
# Formatting
plt.axhline(0, color='black', linewidth=0.5)
plt.axvline(0, color='black', linewidth=0.5)
plt.grid(True, linestyle='--', alpha=0.6)
plt.xlabel("x")
plt.ylabel("y")
plt.legend()
plt.title("Line and Points")

# Save figure
plt.savefig("line_points.png", dpi=300)
plt.show()
    \end{lstlisting}
