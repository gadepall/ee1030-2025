\frametitle{Python Code}
\begin{lstlisting}
# Labels and legend
plt.xlabel("x-axis")
plt.ylabel("y-axis")
plt.title("Region bounded by y=x+1, x=2, x=3 and x-axis")
plt.legend()
plt.grid(True)
plt.axis("equal")

# Save the figure
plt.savefig("fig_8.png", dpi=300, bbox_inches="tight")

# Show the plot
plt.show()
\end{lstlisting}
