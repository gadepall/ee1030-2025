\begin{lstlisting}
# Title and labels
plt.title("Region between $x = y^2$ and $x = 4$ divided equally by $x = a$")
plt.xlabel("x-axis")
plt.ylabel("y-axis")

# Aspect ratio equal
plt.gca().set_aspect('equal', adjustable='box')

plt.grid(True, linestyle='--', alpha=0.5)
plt.savefig("../figs/fig15.png")
plt.show()
\end{lstlisting}
