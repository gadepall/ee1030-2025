\begin{lstlisting}
plt.axvline(0, color='black', linewidth=1)
plt.gca().set_aspect('equal', adjustable='box')
plt.xlim(-4.5 * a, 5.0 * a)
plt.ylim(-4.5 * a, 5.0 * a)

# Title and labels
plt.title(r"Region bounded by $x^2 + y^2 = 16a^2$ and $y^2 = 6ax$")
plt.xlabel("x-axis")
plt.ylabel("y-axis")
plt.grid(alpha=0.3)
plt.savefig("../figs/fig16.png")
# Show plot
plt.show()

\end{lstlisting}
