\frametitle{Python Code: Plotting}
\begin{block}{Part 4}
\begin{lstlisting}[language=Python, basicstyle=\ttfamily\small, keywordstyle=\color{blue}, frame=single]
# Mark the intersection point
plt.scatter(xi, yi, color='black', zorder=5)
plt.text(xi+0.5, yi, f'({xi:.2f},{yi:.2f})', fontsize=10)

plt.xlabel('x')
plt.ylabel('y')
plt.title('Intersection of Lines')
plt.grid(True)
plt.legend()
plt.xlim(-10, 10)
plt.ylim(-10, 10)

# Save figure as fig8.png
plt.savefig('fig8.png', dpi=300)
plt.show()
\end{lstlisting}
\end{block}
