\frametitle{Python Code: Plotting}
\begin{block}{Part 4}
\begin{lstlisting}[language=Python, basicstyle=\ttfamily\small, keywordstyle=\color{blue}, frame=single]
ax.plot(x_vals, y_vals, 'g-',
        label=rf"$({n1:.0f},{n2:.0f})\cdot x = {rhs:.1f}$ (Equation of line passing through (2,3))")

# Mark point A
ax.scatter(Ax, Ay, color='black', zorder=5)
ax.text(Ax+0.1, Ay+0.1, r"$A(2,3)$")

ax.set_xlim(-5, 10)
ax.set_ylim(-5, 10)
ax.set_xlabel("x")
ax.set_ylabel("y")
ax.legend()
ax.grid(True)
ax.set_aspect('equal', adjustable='box')
plt.savefig("fig6.png")
plt.show()

\end{lstlisting}
\end{block}
