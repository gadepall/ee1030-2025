\frametitle{Python Code: Plotting}
\begin{block}{Part 5}
\begin{lstlisting}[language=Python, basicstyle=\ttfamily\small, keywordstyle=\color{blue}, frame=single]
plt.axis('equal')
plt.legend()
plt.grid(True)

plt.xlim(-5, 5)
plt.ylim(-5, 5)

# Save figure
plt.savefig("fig5.png")
plt.show()


\end{lstlisting}
\end{block}
